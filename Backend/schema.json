components:
  schemas:
    ExerciseModule:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        muscle_group:
          $ref: '#/components/schemas/MuscleGroupEnum'
        order:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        sets:
          type: integer
          maximum: 20
          minimum: 1
        reps:
          type: integer
          maximum: 100
          minimum: 1
        target_weight_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,5}(?:\.\d{0,1})?$
      required:
      - id
      - muscle_group
      - name
      - order
      - reps
      - sets
      - target_weight_kg
    MissionRead:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 100
        description:
          type: string
        priority:
          $ref: '#/components/schemas/PriorityEnum'
        mission_type:
          $ref: '#/components/schemas/MissionTypeEnum'
        xp_reward:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        current_progress:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        goal:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        progress_percent:
          type: integer
          readOnly: true
        status:
          $ref: '#/components/schemas/Status3f1Enum'
        deadline:
          type: string
          format: date
          nullable: true
        operator:
          type: integer
        operator_alias:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        completed_at:
          type: string
          format: date-time
          nullable: true
      required:
      - created_at
      - id
      - operator
      - operator_alias
      - progress_percent
      - title
    MissionTypeEnum:
      enum:
      - EJERCICIO
      - HIDRATACION
      - SUENO
      - CUSTOM
      type: string
      description: |-
        * `EJERCICIO` - Ejercicio
        * `HIDRATACION` - Hidratación
        * `SUENO` - Sueño
        * `CUSTOM` - Custom
    MissionWrite:
      type: object
      properties:
        title:
          type: string
          maxLength: 100
        description:
          type: string
        priority:
          $ref: '#/components/schemas/PriorityEnum'
        mission_type:
          $ref: '#/components/schemas/MissionTypeEnum'
        xp_reward:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        current_progress:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        goal:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        status:
          $ref: '#/components/schemas/Status3f1Enum'
        deadline:
          type: string
          format: date
          nullable: true
      required:
      - title
    MuscleGroupEnum:
      enum:
      - PUSH
      - PULL
      - CORE
      - LEGS
      - FULL_BODY
      type: string
      description: |-
        * `PUSH` - Push
