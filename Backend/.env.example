# ====== METABOLIC API — Environment variables ======
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.

# Runtime environment: development | production
ENV=development

# Django debug mode. Must be False in production.
DEBUG=True

# Cryptographic key used by Django for sessions, password hashing, etc.
# Generate a secure one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-in-production

# Comma-separated list of allowed hosts. No wildcard in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS origins allowed to call the API. Include the frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database URL. Use SQLite for local development.
# For production use PostgreSQL:
#   DATABASE_URL=postgres://user:password@localhost:5432/metabolic
DATABASE_URL=sqlite:///db.sqlite3

# HTTPS hardening. Enable only when the app is served over HTTPS.
SECURE_SSL_REDIRECT=False

# Optional: number of proxy hops in front of the app (for SECURE_PROXY_SSL_HEADER)
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=

# Optional: email backend for admin notifications
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@metabolic.io
